RAPIDAPI_KEY=your_key_here
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here

# Optional comma-separated extra CORS origins (e.g. a custom domain)
# CORS_ORIGINS=https://example.com

# Search cache TTL in seconds (default 900 = 15 minutes)
SEARCH_CACHE_TTL_SECONDS=900

# Max API requests per IP per minute (default 30)
RATE_LIMIT_PER_MINUTE=30

# Set to true for extra RapidAPI debug log lines (result counts; no full JSON bodies)
DEBUG_API_RESPONSES=false
